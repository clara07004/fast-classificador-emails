# Variáveis de ambiente — copie pra .env e preencha
# .env é ignorado pelo git. NUNCA commite credenciais.

# Identificação do projeto
PROJECT_NAME=fast-classificador-emails
ENVIRONMENT=development  # development | staging | production
NODE_ENV=development

# Logging
LOG_LEVEL=info  # trace | debug | info | warn | error
LOG_FORMAT=pretty  # pretty | json

# IMAP — CSC Empresarial
# Confirmado pelo TI (protocolo CSC 20246): IDLE suportado, conexões externas aceitas, sem restrição de IP
# Porta 993 (SSL/TLS, recomendado) ou 143 (sem SSL)
IMAP_HOST=mail.cscempresarial.com.br
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# SMTP — notificações (reflexão mensal)
# Mesmo host do IMAP. Porta 587 (sem SSL) ou 465 (com SSL)
SMTP_HOST=mail.cscempresarial.com.br
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Convex
# IMPORTANTE: CONVEX_URL deve estar SEM barra final ("/").
# Com barra, o cliente Convex monta a URL WSS com "//" duplo e o handshake
# falha em loop com WebSocket code 1006.
# CONVEX_DEPLOY_KEY é usada apenas por ferramentas CLI (`npx convex deploy`),
# NÃO pelo runtime. O runtime só lê CONVEX_URL.
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Voyage AI (embeddings)
VOYAGE_API_KEY=

# Funcionário piloto (OBRIGATÓRIO)
# ID do funcionário no Convex (tabela `funcionarios`, campo `_id`).
# Formato típico: kx7... ou similar (~32 caracteres).
# Sem essa variável, o worker faz `throw` no boot e o PM2 entra em loop de
# crash + restart. Veja src/imap/worker.js linha ~415.
PILOTO_FUNCIONARIO_ID=

# Healthcheck externo (scripts/healthcheck-externo.py)
# Email que receberá alertas quando o worker ficar inativo.
# Se não definido, usa SMTP_USER como destinatário.
ALERT_EMAIL=
