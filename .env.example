# Variáveis de ambiente — copie pra .env e preencha
# .env é ignorado pelo git. NUNCA commite credenciais.

# Identificação do projeto
PROJECT_NAME=fast-classificador-emails
ENVIRONMENT=development  # development | staging | production
NODE_ENV=development

# Logging
LOG_LEVEL=info  # trace | debug | info | warn | error
LOG_FORMAT=pretty  # pretty | json

# IMAP — CSC Empresarial
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_TLS=true

# SMTP — notificações (reflexão mensal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# Convex
CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Voyage AI (embeddings)
VOYAGE_API_KEY=
