{
  "name": "fast-classificador-emails",
  "version": "0.1.0",
  "description": "Classificador automático de emails para funcionários da Fast Sistemas Construtivos",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "imapflow": "^1.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "convex": "^1.19.0",
    "nodemailer": "^6.9.0",
    "express": "^4.19.0"
  },
  "devDependencies": {
    "vitest": "^1.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0"
  },
  "author": "Clara Barbosa <clara.barbosa@fastdrywall.com.br>",
  "license": "UNLICENSED",
  "private": true
}
